# Build outputs. Everything here is regenerated from sections/ by pandoc;
# none of it belongs in git.
output/
_site/

# LaTeX intermediates, if you ever run an engine by hand.
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.fls
*.fdb_latexmk

# Demo tooling: Playwright is installed locally to inspect the two live runs.
# The scripts, prompts, brief and starter in demo/ are tracked; dependencies,
# generated reports and screenshots are not. The run folders themselves live
# outside this repository (see demo/README.md).
demo/tools/node_modules/
demo/tools/package-lock.json
demo/output/

# Editor and OS noise.
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Local Claude Code settings. `.claude/skills/` IS tracked — the /round verb is
# part of the template and every team member needs it.
.claude/settings.local.json

# The live demo working folder. Rebuilt by demo/tools/setup.sh; never committed.
demo/run/
